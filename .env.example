# Google Gemini API & 2-Tier Cost-Optimized Models
GEMINI_API_KEY="AIzaSyYourGoogleGeminiApiKey..."
GEMINI_MAIN_MODEL="gemini-3.8-flash"
GEMINI_LITE_MODEL="gemini-3.5-flash-lite"
GEMINI_DEFAULT_THINKING_LEVEL="low"

# Postiz Self-Hosted (docker compose) — UI: http://localhost:4007
JWT_SECRET="replace_with_32_byte_random_hex_secret"
# X (Twitter) developer app: Native App, Read and write.
# Redirect URI: http://localhost:4007/integrations/social/x
X_API_KEY=""
X_API_SECRET=""
# Instagram Standalone (professional account, no Facebook page needed)
# Redirect URI: http://localhost:4007/integrations/social/instagram-standalone
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Instagram via Facebook Business (alternative)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Postiz Public API (Settings > Public API in the Postiz UI)
POSTIZ_BASE_URL="http://localhost:4007/api/public/v1"
POSTIZ_API_KEY="pz_live_..."
POSTIZ_INSTAGRAM_CHANNEL_ID="ch_insta_01"
POSTIZ_X_CHANNEL_ID="ch_x_01"

# Naver Cafe Open API Settings (OAuth 2.0)
NAVER_CLIENT_ID="your_naver_developers_client_id"
NAVER_CLIENT_SECRET="your_naver_developers_client_secret"
NAVER_ACCESS_TOKEN="your_oauth2_access_token"
NAVER_REFRESH_TOKEN="your_oauth2_refresh_token"
NAVER_CAFE_CLUB_ID="12345678"
NAVER_CAFE_MENU_ID="42"

# DC Inside / Telegram Notification Settings
TELEGRAM_BOT_TOKEN="123456789:ABCDEF..."
TELEGRAM_CHAT_ID="987654321"
DCINSIDE_DEFAULT_GALLERY="gadget"
ENABLE_LOCAL_CLIPBOARD="true"
