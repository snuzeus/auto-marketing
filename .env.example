# 이 파일은 설치 때 .env 로 복사됩니다. 값은 웹 화면의 「설정」 탭에서 입력하세요.

# 매장 이름 (공지 카드 하단 표기)
STORE_NAME=""

# Google Gemini (글 생성, 필수)
GEMINI_API_KEY=""
GEMINI_MAIN_MODEL="gemini-3.8-flash"
GEMINI_LITE_MODEL="gemini-3.5-flash-lite"
GEMINI_DEFAULT_THINKING_LEVEL="low"

# Postiz (docker compose) — UI: http://localhost:4007
# JWT_SECRET 은 설치 스크립트가 무작위 값으로 채웁니다.
JWT_SECRET=""
# X developer app: Native App, Read and write.
# Redirect URI: http://localhost:4007/integrations/social/x
X_API_KEY=""
X_API_SECRET=""
# Instagram Standalone (프로페셔널 계정)
# Redirect URI: http://localhost:4007/integrations/social/instagram-standalone
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Instagram via Facebook Business (대안)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Postiz Public API (Postiz 설정 > Agents / Dev)
POSTIZ_BASE_URL="http://localhost:4007/api/public/v1"
POSTIZ_API_KEY=""
# 비워 두면 Postiz에 연결된 채널을 자동으로 찾습니다.
POSTIZ_INSTAGRAM_CHANNEL_ID=""
POSTIZ_X_CHANNEL_ID=""

# Naver Cafe (Callback URL: http://localhost:8000/naver/callback)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
NAVER_ACCESS_TOKEN=""
NAVER_REFRESH_TOKEN=""
NAVER_CAFE_CLUB_ID=""
NAVER_CAFE_MENU_ID=""

# Telegram (네이버 게시 승인)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# DC Inside (갤러리 ID 또는 주소)
DCINSIDE_DEFAULT_GALLERY=""
ENABLE_LOCAL_CLIPBOARD="true"
